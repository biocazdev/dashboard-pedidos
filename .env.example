# =========================================================
# Configuracao do Dashboard de Faturamento de Pedidos
# Copie este arquivo para ".env" e ajuste os valores.
# O run_dashboard.bat ja faz essa copia automaticamente na
# primeira execucao, se o .env ainda nao existir.
# =========================================================

# DEMO_MODE=True  -> usa dados FICTICIOS gerados em memoria (mock_data.py),
#                     sem precisar de conexao com o Protheus. Bom para
#                     testar o dashboard agora mesmo.
# DEMO_MODE=False -> conecta no SQL Server do Protheus com os dados abaixo
#                     e roda as consultas reais nas tabelas SC5/SC6/SD2/SF2/SA1/SB1/SA3.
DEMO_MODE=True

# ---------------------------------------------------------
# Conexao com o SQL Server do Protheus (usada quando DEMO_MODE=False)
# ---------------------------------------------------------
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=PROTHEUS12
DB_USER=usuario_leitura
DB_PASSWORD=troque_esta_senha
# Driver ODBC instalado na maquina. Confira em "ODBC Data Sources (64-bit)".
# Comuns: "ODBC Driver 17 for SQL Server" ou "ODBC Driver 18 for SQL Server"
DB_DRIVER=ODBC Driver 17 for SQL Server

# ---------------------------------------------------------
# Dicionario de dados Protheus
# ---------------------------------------------------------
# Sufixo numerico/alfanumerico das tabelas fisicas no banco.
# No Protheus, as tabelas do dicionario (SC5, SC6, SD2, SF2, SA1, SB1, SA3...)
# sao criadas no banco com um sufixo fixo por ambiente, ex: SC5010, SC6010.
# Confirme o sufixo correto com o time de TI/Basis do Protheus
# (Configurador > Base de Dados, ou olhando o nome real das tabelas no banco).
PROTHEUS_TABLE_SUFFIX=010

# Filial do Protheus a ser considerada nas consultas (C5_FILIAL, C6_FILIAL, F2_FILIAL...)
FILIAL=01
